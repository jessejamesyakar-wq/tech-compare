{
  "name": "aceleetme-control-hub",
  "version": "0.5.0",
  "description": "ACELEETME Control Hub V0.5 Windows Autonomous Runner",
  "private": true,
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test test/controlHub.test.ts",
    "task": "npx tsx src/cli.ts",
    "status": "npx tsx src/cli.ts status",
    "queue:add": "npx tsx src/cli.ts queue:add",
    "queue:run": "npx tsx src/cli.ts queue:run",
    "queue:list": "npx tsx src/cli.ts queue:list",
    "decisions": "npx tsx src/cli.ts decisions",
    "pause": "npx tsx src/cli.ts pause",
    "resume": "npx tsx src/cli.ts resume",
    "summary": "npx tsx src/cli.ts summary",
    "runner:health": "npx tsx src/cli.ts health",
    "runner:start": "npx tsx src/daemon.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
